# Accommodating for CRLF line endings, which some of the sample's and the test World's vignettes have: vignettes are
# fingerprinted over their raw bytes.
/worlds/sample/vignettes/** -text
/worlds/test/vignettes/** -text
# Accommodating for branches that each append to the cost log: a merge keeps both sides' lines.
/dev/costs.tsv merge=union
