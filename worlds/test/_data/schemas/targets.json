{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Targets",
  "description": "What a case's answer is held to, per kind of target, and clinicians' notes on the case. The sample's kinds, for the test World.",
  "type": "object",
  "required": ["diagnosis"],
  "additionalProperties": false,
  "properties": {
    "diagnosis": { "$ref": "#/$defs/target" },
    "warning": { "oneOf": [{ "$ref": "#/$defs/target" }, { "const": false }] },
    "disposition": { "$ref": "#/$defs/target" },
    "dont_miss": { "$ref": "#/$defs/target" },
    "notes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/note" } }
  },
  "$defs": {
    "target": {
      "type": "object",
      "anyOf": [{ "required": ["pattern"] }, { "required": ["text"] }],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "pattern": { "type": "string", "minLength": 1 }
      }
    },
    "note": {
      "type": "object",
      "required": ["author", "language", "comment"],
      "additionalProperties": false,
      "properties": {
        "author": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{1,8})*$", "examples": ["sv", "en"] },
        "comment": { "type": "string", "minLength": 1 },
        "answer": { "type": "string", "minLength": 1 }
      }
    }
  }
}
