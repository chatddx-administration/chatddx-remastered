#: src/chatddx/factors/lint.py
#, python-format
msgctxt "vllm.temperature_clamped"
msgid "vLLM 0.24 raises temperature %(temperature)s to 0.01"
msgstr "vLLM 0.24 höjer temperaturen %(temperature)s till 0.01"

#: src/chatddx/factors/lint.py
msgctxt "vllm.thinking_budget_refused"
msgid ""
"vLLM 0.24 refuses thinking_token_budget without --reasoning-parser or "
"--reasoning-config"
msgstr ""
"vLLM 0.24 vägrar thinking_token_budget utan --reasoning-parser eller "
"--reasoning-config"

#: src/chatddx/factors/lint.py
#, python-format
msgctxt "vllm.tools_refused"
msgid ""
"vLLM 0.24 refuses tool_choice %(choice)s without --enable-auto-tool-"
"choice and --tool-call-parser; for harmony and Mistral models it goes out"
" unconstrained instead"
msgstr ""
"vLLM 0.24 vägrar tool_choice %(choice)s utan --enable-auto-tool-choice "
"och --tool-call-parser; för harmony- och Mistral-modeller går den ut "
"obegränsad i stället"

#: src/chatddx/factors/lint.py
msgctxt "vllm.native_tools_uncallable"
msgid ""
"with tool_choice auto, vLLM 0.24 constrains the whole answer to "
"response_format, so no tool can be called"
msgstr ""
"med tool_choice auto begränsar vLLM 0.24 hela svaret till "
"response_format, så inget verktyg kan anropas"

#: src/chatddx/factors/lint.py
msgctxt "vllm.grammar_before_reasoning"
msgid ""
"without --reasoning-parser, vLLM 0.24 constrains the answer from its "
"first token, so a model can't reason first"
msgstr ""
"utan --reasoning-parser begränsar vLLM 0.24 svaret från dess första "
"token, så en modell kan inte resonera först"

