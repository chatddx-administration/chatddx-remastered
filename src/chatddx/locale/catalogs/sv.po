msgstr "en $ref i schemat kan inte lösas upp: %(ref)s"

#: src/chatddx/factors/lint.py
msgctxt "schema.ref_unverified"
msgid ""
"the schema has $ref, which this engine isn't known to resolve; "
"inline_refs@1 removes them"
msgstr ""
"schemat har $ref, som den här motorn inte är känd för att lösa upp; "
"inline_refs@1 tar bort dem"

#: src/chatddx/factors/lint.py
#, python-format
msgctxt "schema.ref_unverified"
