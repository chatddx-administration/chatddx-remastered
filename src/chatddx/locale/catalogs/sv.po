#: src/chatddx/bench/seen.py
msgctxt "whoops"
msgid ""
"No model in the Library holds these weights, though one should: use "
"another model meanwhile."
msgstr ""
"Ingen modell i Biblioteket håller de här vikterna, fast en borde: använd "
"en annan modell så länge."

