{
  "name": "chatddx-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "types": "openapi-typescript openapi.json --default-non-nullable false --output src/lib/api/schema.d.ts",
    "build": "pnpm types && vite build",
    "watch": "pnpm types && vite build --watch",
    "check": "pnpm types && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run"
  },
  "devDependencies": {
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "1.55.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.20.5",
    "bits-ui": "2.19.5",
    "clsx": "2.1.1",
    "openapi-fetch": "0.17.0",
    "openapi-typescript": "7.13.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
